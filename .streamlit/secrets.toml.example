# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is gitignored and must never be committed.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "generate-with: python -c \"import secrets; print(secrets.token_hex(32))\""
client_id = "streamlit-app"
client_secret = "paste-from-keycloak-client-credentials-tab"
server_metadata_url = "http://keycloak.local:8080/realms/streamlit-app/.well-known/openid-configuration"
